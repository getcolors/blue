#!/usr/bin/env -S uv run --script
# -*- mode: python-ts; -*-
# /// script
# requires-python = ">=3.11"
# dependencies = ["blue"]
#
# [tool.uv.sources]
# blue = { path = "../.." }
# ///
# Self-contained blue CLI for a REAL 3-node ZooKeeper cluster:
# OpenTofu (AWS provider pointed at floci, a local AWS emulator) creates
# one Docker-backed EC2 instance per node, and Ansible over SSH provisions
# ZooKeeper. Linux only: Ansible and health checks talk straight to the
# instances' Docker-bridge IPs.

import asyncio
import json
import os
import re
import sys
import urllib.request
from pathlib import Path

from blue import dry_run, progress, tofu
from blue.ansible import ansible_with_spec, inventory_advice, playbook
from blue.cli import exec_cli, run_cli
from blue.runtime import runtime
from blue.scaffold import scaffold
from blue.workflow import StepError, advice_add, failed, step, workflow

SCRIPT_DIR = Path(__file__).resolve().parent
FLOCI_ENDPOINT = "http://localhost:4566"

create_yml = (SCRIPT_DIR / "resources/zk/ansible/create.yml").read_text()
delete_node_yml = (SCRIPT_DIR / "resources/zk/ansible/delete-node.yml").read_text()
zoo_cfg_j2 = (SCRIPT_DIR / "resources/zk/ansible/zoo.cfg.j2").read_text()
main_tf = (SCRIPT_DIR / "resources/zk/main.tf").read_text()
shared_tf = (SCRIPT_DIR / "resources/zk/shared.tf").read_text()


def example_path(p):
    if p is None:
        return None
    return p if os.path.isabs(p) else str(SCRIPT_DIR / p)


def workdir(opts):
    return example_path(opts["zk/workdir"])


def shared_dir(opts):
    return os.path.join(workdir(opts), "shared")


def node_dir(opts, node):
    return os.path.join(workdir(opts), "nodes", str(node["id"]))


def ssh_key(opts):
    return os.path.join(workdir(opts), "ssh", "id_ed25519")


def node_inventory_file(opts):
    return os.path.join(workdir(opts), "ansible", str(opts["zk/node"]["id"]), "inventory.ini")


def log(*xs):
    runtime.log(*xs)


async def sh(cmd, cwd=None, env=None):
    res = await runtime.exec(cmd, cwd=cwd, env=env)
    if res.exit > 0:
        raise RuntimeError(f"{cmd[0]} failed: {res.err or res.out or '(no output)'}")
    return res.out


async def tool(*cmd):
    try:
        return (await runtime.exec(list(cmd))).exit == 0
    except Exception:
        return False


def servers(opts):
    return opts.get("zk/servers") or []


# --- validation advices ------------------------------------------------------


def check_schema(opts):
    ss = opts.get("zk/servers")
    problems = []
    if not isinstance(opts.get("zk/workdir"), str):
        problems.append("zk/workdir must be a string")
    if not isinstance(opts.get("zk/ami"), str):
        problems.append("zk/ami must be a string")
    if not isinstance(opts.get("zk/user"), str):
        problems.append("zk/user must be a string")
    it = opts.get("zk/instance-type")
    if it is not None and not isinstance(it, str):
        problems.append("zk/instance-type must be a string when present")
    if not isinstance(ss, list) or len(ss) == 0:
        problems.append("zk/servers must be a non-empty array")
    else:
        def ok(s):
            return (
                isinstance(s, dict)
                and isinstance(s.get("id"), int)
                and not isinstance(s.get("id"), bool)
                and s["id"] > 0
                and isinstance(s.get("name"), str)
            )

        if not all(ok(s) for s in ss):
            problems.append("every server needs a positive id and a string name")
        if len({s.get("id") for s in ss if isinstance(s, dict)}) != len(ss):
            problems.append("server id values must be unique")
        if len({s.get("name") for s in ss if isinstance(s, dict)}) != len(ss):
            problems.append("server name values must be unique")
    if problems:
        raise StepError(f"invalid desired state: {'; '.join(problems)}", exit=2)
    return True


async def check_requirements(opts):
    if not opts.get("blue/dry-run"):
        missing = []
        if not await tool("tofu", "version"):
            missing.append("tofu")
        if not await tool("ansible-playbook", "--version"):
            missing.append("ansible-playbook")
        if not await tool("docker", "ps"):
            missing.append("docker")
        if not await tool("aws", "--version"):
            missing.append("aws")
        if missing:
            raise StepError(f"missing requirements: {', '.join(missing)}", exit=2)
    return True


def check_node_input(opts):
    node = opts.get("zk/node")
    if not isinstance(node, dict) or not node.get("id"):
        raise StepError("step zk/node needs zk/node {id, name} in opts", exit=2)
    return True


# --- prerequisites (before = setup) -------------------------------------------

AWS_ENV = {
    "AWS_ACCESS_KEY_ID": "test",
    "AWS_SECRET_ACCESS_KEY": "test",
    "AWS_DEFAULT_REGION": "us-east-1",
}


def any_nested_value(x):
    if isinstance(x, list):
        return any(any_nested_value(v) for v in x)
    return x is not None and x != ""


async def running_instances():
    try:
        out = await sh(
            [
                "aws",
                "--endpoint-url",
                FLOCI_ENDPOINT,
                "ec2",
                "describe-instances",
                "--filters",
                "Name=instance-state-name,Values=running,pending",
                "--query",
                "Reservations[*].Instances[*].InstanceId",
                "--output",
                "json",
            ],
            env=AWS_ENV,
        )
        return any_nested_value(json.loads(out))
    except Exception:
        return False


def clear_tofu_state(opts):
    root = workdir(opts)
    if not os.path.exists(root):
        return
    for dirpath, _dirnames, filenames in os.walk(root):
        for name in filenames:
            if name.endswith(".tfstate"):
                os.unlink(os.path.join(dirpath, name))


def _http_ok(url):
    try:
        with urllib.request.urlopen(url, timeout=3) as res:
            return 200 <= res.status < 300
    except Exception:
        return False


async def floci_healthy():
    return await asyncio.to_thread(_http_ok, f"{FLOCI_ENDPOINT}/_localstack/health")


async def wait_floci():
    for _ in range(60):
        if await floci_healthy():
            return
        await asyncio.sleep(1)
    raise RuntimeError("floci did not become healthy")


async def remove_ec2_containers():
    ids = (await sh(["docker", "ps", "-aq", "--filter", "name=floci-ec2"])).strip()
    if ids:
        await sh(["docker", "rm", "-f", *ids.split()])


async def restart_floci():
    await remove_ec2_containers()
    await sh(["docker", "restart", "floci"])
    await wait_floci()


async def ensure_floci(opts):
    if not opts.get("blue/dry-run"):
        if await running_instances():
            log("floci: instances present — skipping restart")
        else:
            log("floci: no instances — restarting for clean state")
            await restart_floci()
            clear_tofu_state(opts)
    return opts


async def ensure_ssh_key(opts):
    if not opts.get("blue/dry-run"):
        key = ssh_key(opts)
        if not os.path.exists(key):
            os.makedirs(os.path.dirname(key), exist_ok=True)
            await sh(["ssh-keygen", "-t", "ed25519", "-f", key, "-N", "", "-q"])
    return opts


def dry_aware_local_backend(dir_fn):
    write_backend = tofu.local_backend_advice(dir_fn)
    return lambda opts: opts if opts.get("blue/dry-run") else write_backend(opts)


# --- steps -------------------------------------------------------------------


async def start_step(opts):
    if opts.get("blue/dry-run"):
        return opts
    dir = shared_dir(opts)
    specs = [
        {
            "template": {"name": "zk/shared.tf", "content": shared_tf},
            "target": os.path.join(dir, "shared.tf"),
            "data": {"endpoint": FLOCI_ENDPOINT, "pubkey": f"{ssh_key(opts)}.pub"},
        }
    ]
    if opts.get("blue/event") == "delete":
        out = await tofu.tofu_step(opts, dir=dir, output_key="zk/shared")
        return out if failed(out) else scaffold(out, specs)
    return await tofu.tofu_step(scaffold(opts, specs), dir=dir, output_key="zk/shared")


async def node_step(opts):
    node = opts["zk/node"]
    dir = node_dir(opts, node)
    specs = [
        {
            "template": {"name": "zk/main.tf", "content": main_tf},
            "target": os.path.join(dir, "main.tf"),
            "data": {
                "node": node,
                "ami": opts["zk/ami"],
                "instance-type": opts.get("zk/instance-type") or "t3.micro",
                "endpoint": FLOCI_ENDPOINT,
                "key-name": "zk",
            },
        }
    ]
    if opts.get("blue/event") == "delete":
        out = await tofu.tofu_step(opts, dir=dir)
        return out if failed(out) else scaffold(out, specs)
    return await tofu.tofu_step(scaffold(opts, specs), dir=dir)


def provision_step(opts):
    nodes = sorted(
        (
            b["tofu/outputs"]
            for b in (opts.get("blue/branches") or [])
            if b.get("tofu/outputs")
        ),
        key=lambda n: n["id"],
    )
    return {**opts, "zk/nodes": nodes}


async def with_node_info(opts):
    if opts.get("blue/event") == "delete" and opts.get("zk/nodes") is None:
        node = opts["zk/node"]
        try:
            node_info = await tofu.outputs(node_dir(opts, node))
        except Exception:
            node_info = None
        return {**opts, "zk/nodes": [node_info] if node_info and node_info.get("ip") else []}
    return opts


async def ssh_open(ip):
    try:
        _reader, writer = await asyncio.wait_for(asyncio.open_connection(ip, 22), timeout=2)
        writer.close()
        return True
    except Exception:
        return False


async def wait_for_ssh(opts):
    if opts.get("blue/event") != "delete":
        node = opts["zk/node"]
        info = next((n for n in (opts.get("zk/nodes") or []) if n["id"] == node["id"]), None)
        if not info or not info.get("ip"):
            raise RuntimeError(f"no IP known for {node['name']}")
        for _ in range(60):
            if await ssh_open(info["ip"]):
                return opts
            await asyncio.sleep(3)
        raise RuntimeError(f"ssh on {node['name']} ({info['ip']}:22) never came up")
    return opts


def node_inventory_data(opts):
    node = opts["zk/node"]
    info = next((n for n in (opts.get("zk/nodes") or []) if n["id"] == node["id"]), None)
    return {
        "zookeeper": {
            "hosts": [
                {
                    "name": node["name"],
                    "vars": {
                        "ansible_host": info.get("ip") if info else None,
                        "zk_id": node["id"],
                    },
                }
            ],
            "vars": {
                "ansible_user": opts["zk/user"],
                "ansible_python_interpreter": "/usr/bin/python3",
            },
        }
    }


ansible_template_opts = {
    "tag_open": "<",
    "tag_close": ">",
    "filter_open": "{",
    "filter_close": "}",
}


def ansible_dir(opts):
    return os.path.join(workdir(opts), "ansible", str(opts["zk/node"]["id"]))


def ansible_specs(opts):
    dir = ansible_dir(opts)
    return [
        {
            "template": {"name": "zk/ansible/create.yml", "content": create_yml},
            "target": os.path.join(dir, "create.yml"),
            "data": {},
            "opts": ansible_template_opts,
        },
        {
            "template": {"name": "zk/ansible/delete-node.yml", "content": delete_node_yml},
            "target": os.path.join(dir, "delete-node.yml"),
            "data": {},
            "opts": ansible_template_opts,
        },
        {
            "template": {"name": "zk/ansible/zoo.cfg.j2", "content": zoo_cfg_j2},
            "target": os.path.join(dir, "templates", "zoo.cfg.j2"),
            "data": {},
            "opts": ansible_template_opts,
        },
    ]


async def zk_ansible_step(opts):
    node = opts["zk/node"]
    delete_event = opts.get("blue/event") == "delete"
    if delete_event and len(opts.get("zk/nodes") or []) == 0:
        log(f"ansible: skipping {node['name']} (no state)")
        return opts
    log(
        f"ansible: {playbook(opts, {'delete': 'delete-node.yml'})} on {node['name']}"
        + ("" if delete_event else " — a first create takes a few minutes")
    )
    extra_vars = (
        None
        if delete_event
        else {"ensemble": [{"id": n["id"], "ip": n.get("ip")} for n in (opts.get("zk/nodes") or [])]}
    )
    return await ansible_with_spec(
        opts,
        ansible_specs(opts),
        dir=ansible_dir(opts),
        inventory=node_inventory_file(opts),
        private_key=ssh_key(opts),
        host_key_checking=False,
        playbooks={"delete": "delete-node.yml"},
        extra_vars=extra_vars,
    )


teardown_step = step(
    workflow(
        start="zk/ansible",
        wire_fn=lambda s, _: {
            "zk/ansible": (zk_ansible_step, "zk/node"),
            "zk/node": (node_step,),
        }.get(s),
    )
)


async def four_letter(ip, port, word):
    reader, writer = await asyncio.wait_for(asyncio.open_connection(ip, port), timeout=3)
    try:
        writer.write(word.encode())
        await writer.drain()
        data = await asyncio.wait_for(reader.read(), timeout=3)
        return data.decode()
    finally:
        writer.close()


async def server_mode(ip):
    m = re.search(r"Mode: (\w+)", await four_letter(ip, 2181, "srvr"))
    return m.group(1) if m else None


async def health_step(opts):
    nodes = opts.get("zk/nodes") or []

    async def mode_of(node):
        if not node.get("ip"):
            return {"name": node.get("name"), "mode": "error: no ip"}
        try:
            return {"name": node.get("name"), "mode": await server_mode(node["ip"])}
        except Exception as e:
            return {"name": node.get("name"), "mode": f"error: {e}"}

    modes = list(await asyncio.gather(*(mode_of(n) for n in nodes)))
    tally = {}
    for m in modes:
        key = m["mode"] if m["mode"] is not None else "unknown"
        tally[key] = tally.get(key, 0) + 1
    if nodes and tally.get("leader") == 1 and tally.get("follower") == len(nodes) - 1:
        log("health:", ", ".join(f"{m['name']}={m['mode']}" for m in modes))
        return {**opts, "blue/exit": 0, "zk/health": modes}
    return {
        **opts,
        "blue/exit": 1,
        "zk/health": modes,
        "blue/err": f"quorum not healthy: {json.dumps(modes)}",
    }


def retry_advice(attempts, pause_s):
    async def advice(f, opts):
        n = 1
        while True:
            res = await f(opts)
            if (res.get("blue/exit") or 0) == 0 or n >= attempts:
                return res
            log(f"health: not converged (attempt {n}/{attempts}), retrying in {pause_s}s")
            await asyncio.sleep(pause_s)
            n += 1

    return advice


# --- workflow ----------------------------------------------------------------


def wire_fn(s, run_opts):
    delete_event = run_opts.get("blue/event") == "delete"
    return {
        "zk/start": (start_step, "zk/teardown" if delete_event else "zk/node"),
        "zk/node": (node_step, "zk/provision"),
        "zk/provision": (provision_step, "zk/ansible"),
        "zk/ansible": (zk_ansible_step, "zk/health"),
        "zk/health": (health_step,),
        "zk/teardown": (teardown_step,),
    }.get(s)


def next_fn(s, default_next, opts):
    if failed(opts):
        return []
    if s == "zk/start" and opts.get("blue/event") != "delete":
        return [("zk/node", {**opts, "zk/node": n}) for n in servers(opts)]
    if s == "zk/provision":
        return [("zk/ansible", {**opts, "zk/node": n}) for n in servers(opts)]
    if s == "zk/start" and opts.get("blue/event") == "delete":
        return [("zk/teardown", {**opts, "zk/node": n}) for n in servers(opts)]
    return [(n, opts) for n in (default_next or [])]


def inventory_when_present(opts):
    if opts.get("blue/event") == "delete" and len(opts.get("zk/nodes") or []) == 0:
        return opts
    return inventory_advice(node_inventory_file, node_inventory_data)(opts)


wf = workflow(start="zk/start", wire_fn=wire_fn, next_fn=next_fn)
wf = advice_add(wf, "zk/start", "before", "floci/shared-backend", dry_aware_local_backend(shared_dir))
wf = advice_add(wf, "zk/start", "before", "floci/floci", ensure_floci)
wf = advice_add(wf, "zk/start", "before", "floci/ssh-key", ensure_ssh_key)
wf = advice_add(wf, "zk/start", "before-while", "floci/requirements", check_requirements)
wf = advice_add(wf, "zk/start", "before-while", "floci/schema", check_schema)
wf = advice_add(wf, "zk/node", "before", "floci/backend", tofu.local_backend_advice(lambda o: node_dir(o, o["zk/node"])))
wf = advice_add(wf, "zk/node", "before-while", "floci/inputs", check_node_input)
wf = advice_add(wf, "zk/ansible", "before", "floci/wait-ssh", wait_for_ssh)
wf = advice_add(wf, "zk/ansible", "before", "floci/inventory", inventory_when_present)
wf = advice_add(wf, "zk/ansible", "filter-args", "floci/node-info", with_node_info)
wf = advice_add(wf, "zk/health", "around", "floci/retry", retry_advice(12, 5))
wf = progress.advise(wf)
wf = dry_run.advise(wf, ["zk/node", "zk/ansible", "zk/health"])

# --- CLI ---------------------------------------------------------------------


def file_arg(a):
    return a in ("-f", "--file") or a.startswith("--file=")


def default_args(args):
    return args if any(file_arg(a) for a in args) else [*args, "-f", str(SCRIPT_DIR / "blue.yml")]


def run(*args):
    """REPL/test-friendly entrypoint: resolves without calling sys.exit."""
    return run_cli(wf, default_args(list(args)))


if __name__ == "__main__":
    exec_cli(wf, default_args(sys.argv[1:]))
