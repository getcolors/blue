#!/usr/bin/env -S uv run --script
# -*- mode: python-ts; -*-
# /// script
# requires-python = ">=3.11"
# dependencies = ["blue"]
#
# [tool.uv.sources]
# blue = { path = "../.." }
# ///
# Self-contained blue CLI for a single-machine PaaS in the style of
# Basecamp ONCE. One VPS runs a dockerized website operated by ONCE; blue
# provisions the infra with OpenTofu (fake HCL, locals/output only) and
# scaffolds the Ansible config that would configure the box.
#
#   ./blue create   |   ./blue create --dry-run   |   ./blue delete
#
# Graph:
#   compute -+                              +-> ansible-local  (~/.ssh/config)
#            +-> dns -> smtp-post ----------+
#   smtp ----+                              +-> ansible-remote (playbook)
#
# See SPEC.md for the full design.

import os
import sys
from pathlib import Path

from blue import dry_run, tofu
from blue.cli import exec_cli, run_cli
from blue.scaffold import render_template, scaffold
from blue.workflow import advice_add, workflow

SCRIPT_DIR = Path(__file__).resolve().parent

cloudflare_tf = (SCRIPT_DIR / "resources/once/cloudflare/main.tf").read_text()
do_tf = (SCRIPT_DIR / "resources/once/do/main.tf").read_text()
oci_tf = (SCRIPT_DIR / "resources/once/oci/main.tf").read_text()
playbook_yml = (SCRIPT_DIR / "resources/once/playbook.yml").read_text()
smtp_post_tf = (SCRIPT_DIR / "resources/once/smtp-post/main.tf").read_text()
smtp_tf = (SCRIPT_DIR / "resources/once/smtp/main.tf").read_text()
ssh_config = (SCRIPT_DIR / "resources/once/ssh-config").read_text()

# --- paths: one isolated tofu working dir per step ----------------------------
# Dir names are the generic resource they hold (server, smtp), not the step.


def example_path(p):
    if p is None:
        return None
    return p if p.startswith("/") else f"{SCRIPT_DIR}/{p}"


def workdir(opts):
    return example_path(opts.get("once/workdir"))


def step_dir(opts, nm):
    return f"{workdir(opts)}/{nm}"


def server_dir(opts):
    return step_dir(opts, "server")


def smtp_dir(opts):
    return step_dir(opts, "smtp")


def dns_dir(opts):
    return step_dir(opts, "dns")


def smtp_post_dir(opts):
    return step_dir(opts, "smtp-post")


# --- domain discovery from once/website ---------------------------------------


def apex(hostname):
    """example.com from chat.example.com (last two labels)."""
    return ".".join(hostname.split(".")[-2:])


def sending_domain(opts):
    """The smtp identity is always notifications.<domain>.<tld>, derived from
    the website hostnames' apex."""
    return f"notifications.{apex(opts['once/website'][0]['hostname'])}"


# --- provider-swap advice (headline) --------------------------------------------
# Exactly the tofu backend-as-advice idiom: a `before` advice that scaffolds
# the provider-specific main.tf before `compute` runs. Swap clouds by
# re-adding under the same "once/provider" id — downstream steps never learn
# which cloud produced the host.


def provider_advice(template, dir_fn):
    def advice(opts):
        dir = dir_fn(opts)
        os.makedirs(dir, exist_ok=True)
        Path(f"{dir}/main.tf").write_text(
            render_template(template, {"host": opts["once/host"], "ssh": opts["once/ssh"]})
        )
        return opts

    return advice


digitalocean_provider = provider_advice(
    {"name": "once/do/main.tf", "content": do_tf}, server_dir
)
oci_provider = provider_advice({"name": "once/oci/main.tf", "content": oci_tf}, server_dir)

# --- tofu steps -------------------------------------------------------------------


def start_step(opts):
    return opts


def compute_step(opts):
    """compute is a bare tofu run: its main.tf is written by the
    "once/provider" advice and its backend.tf by the "once/backend" advice,
    both `before`."""
    return tofu.tofu_step(opts, dir=server_dir(opts))


async def tofu_with_spec(opts, dir, specs):
    """Scaffold main.tf then apply (create); or destroy then remove main.tf
    (delete). The zookeeper node-step pattern."""
    if opts.get("blue/event") == "delete":
        out = await tofu.tofu_step(opts, dir=dir)
        return out if (out.get("blue/exit") or 0) > 0 else scaffold(out, specs)
    return await tofu.tofu_step(scaffold(opts, specs), dir=dir)


def smtp_step(opts):
    dir = smtp_dir(opts)
    specs = [
        {
            "template": {"name": "once/smtp/main.tf", "content": smtp_tf},
            "target": f"{dir}/main.tf",
            "data": {
                "subdomain": sending_domain(opts),
                "id": f"snd-{apex(opts['once/website'][0]['hostname']).replace('.', '-')}",
                "username": "resend",
                "password": "mock-smtp-secret",
            },
        }
    ]
    return tofu_with_spec(opts, dir, specs)


def dns_step(opts):
    """dns joins compute and smtp: it needs compute's ip and smtp's records.
    It also carries the two provisioning outputs forward (once/server,
    once/smtp) so smtp-post and the ansible steps can read them without
    blue/branches."""
    dir = dns_dir(opts)
    outs = [b.get("tofu/outputs") for b in opts["blue/branches"]]
    compute_out = next((o for o in outs if o and o.get("ip")), None)
    smtp_out = next((o for o in outs if o and o.get("records")), None)
    specs = [
        {
            "template": {"name": "once/cloudflare/main.tf", "content": cloudflare_tf},
            "target": f"{dir}/main.tf",
            "data": {
                "ip": compute_out.get("ip") if compute_out else None,
                "hostnames": [w["hostname"] for w in opts["once/website"]],
                "email": smtp_out.get("records") if smtp_out else None,
            },
        }
    ]
    return tofu_with_spec(
        {**opts, "once/server": compute_out, "once/smtp": smtp_out}, dir, specs
    )


def smtp_post_step(opts):
    dir = smtp_post_dir(opts)
    smtp_out = opts.get("once/smtp") or {}
    specs = [
        {
            "template": {"name": "once/smtp-post/main.tf", "content": smtp_post_tf},
            "target": f"{dir}/main.tf",
            "data": {"id": smtp_out.get("id"), "subdomain": sending_domain(opts)},
        }
    ]
    return tofu_with_spec(opts, dir, specs)


# --- scaffold-only steps (no command) -----------------------------------------------


def ansible_local_step(opts):
    """ansible-local configures the OPERATOR's machine: a ~/.ssh/config Host
    entry for the new VPS, rendered as a fragment to Include."""
    srv = opts.get("once/server") or {}
    specs = [
        {
            "template": {"name": "once/ssh-config", "content": ssh_config},
            "target": f"{workdir(opts)}/ansible-local/config",
            "data": {
                "name": srv.get("name"),
                "ip": srv.get("ip"),
                "sudoer": srv.get("sudoer"),
                "identity": "~/.ssh/once_compute",
            },
        }
    ]
    return scaffold(opts, specs)


def ansible_remote_step(opts):
    """ansible-remote configures the BOX: the playbook (Docker + ONCE + sites)."""
    specs = [
        {
            "template": {"name": "once/playbook.yml", "content": playbook_yml},
            "target": f"{workdir(opts)}/ansible-remote/playbook.yml",
            "data": {
                "host": opts.get("once/server"),
                "smtp": opts.get("once/smtp"),
                "websites": opts["once/website"],
                "deploy_key": (opts.get("once/ssh") or {}).get("deploy"),
            },
        }
    ]
    return scaffold(opts, specs)


# --- wiring ----------------------------------------------------------------------------


def wire_fn(step, _run_opts):
    return {
        "once/start": (start_step, "once/compute", "once/smtp"),
        "once/compute": (compute_step, "once/dns"),
        "once/smtp": (smtp_step, "once/dns"),
        "once/dns": (dns_step, "once/smtp-post"),
        "once/smtp-post": (smtp_post_step, "once/ansible-local", "once/ansible-remote"),
        "once/ansible-local": (ansible_local_step,),
        "once/ansible-remote": (ansible_remote_step,),
    }.get(step)


def once_wf():
    wf = workflow(start="once/start", wire_fn=wire_fn)
    # provider swap (headline): compute's HCL is chosen by advice.
    #   swap to Oracle Cloud by re-adding under the same "once/provider" id:
    #     advice_add(wf, "once/compute", "before", "once/provider", oci_provider)
    wf = advice_add(wf, "once/compute", "before", "once/provider", digitalocean_provider)
    # backend as advice: one isolated tofu state per tofu step. Local here;
    # for s3, isolate by a per-step key derived from the same dir, e.g.
    #   tofu.s3_backend_advice(server_dir, lambda o: {"bucket": "once-tfstate",
    #     "key": "once/server/terraform.tfstate", "region": "eu-west-1"})
    wf = advice_add(wf, "once/compute", "before", "once/backend", tofu.local_backend_advice(server_dir))
    wf = advice_add(wf, "once/smtp", "before", "once/backend", tofu.local_backend_advice(smtp_dir))
    wf = advice_add(wf, "once/dns", "before", "once/backend", tofu.local_backend_advice(dns_dir))
    wf = advice_add(wf, "once/smtp-post", "before", "once/backend", tofu.local_backend_advice(smtp_post_dir))
    # ./blue create --dry-run prints what would run instead of running it
    return dry_run.advise(
        wf,
        [
            "once/compute",
            "once/smtp",
            "once/dns",
            "once/smtp-post",
            "once/ansible-local",
            "once/ansible-remote",
        ],
    )


wf = once_wf()


def file_arg(a):
    return a in ("-f", "--file") or a.startswith("--file=")


def default_args(args):
    return args if any(file_arg(a) for a in args) else [*args, "-f", f"{SCRIPT_DIR}/blue.yml"]


def run(*args):
    """REPL/test-friendly entrypoint: resolves without calling sys.exit."""
    return run_cli(wf, default_args(list(args)))


if __name__ == "__main__":
    exec_cli(wf, default_args(sys.argv[1:]))
