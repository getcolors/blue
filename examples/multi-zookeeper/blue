#!/usr/bin/env -S uv run --script
# -*- mode: python-ts; -*-
# /// script
# requires-python = ">=3.11"
# dependencies = ["blue"]
#
# [tool.uv.sources]
# blue = { path = "../.." }
# ///
# Two fake ZooKeeper clusters from ONE cluster workflow, composed with
# wf `step`. Run from this directory:   ./blue create   |   ./blue delete

import sys
from pathlib import Path

from blue import dry_run, tofu
from blue.cli import exec_cli, run_cli
from blue.runtime import runtime
from blue.scaffold import scaffold
from blue.workflow import advice_add, step, workflow

SCRIPT_DIR = Path(__file__).resolve().parent

main_tf = (SCRIPT_DIR / "resources/zk/main.tf").read_text()
zoo_cfg = (SCRIPT_DIR / "resources/zk/zoo.cfg").read_text()

# --- the single-cluster workflow (same shape as examples/zookeeper) -----------


def example_path(p):
    if p is None:
        return None
    return p if p.startswith("/") else f"{SCRIPT_DIR}/{p}"


def workdir(opts):
    return example_path(opts.get("zk/workdir"))


def node_dir(opts, node):
    return f"{workdir(opts)}/nodes/{node['id']}"


def start_step(opts):
    return opts


async def node_step(opts):
    node = opts["zk/node"]
    dir = node_dir(opts, node)
    specs = [
        {
            "template": {"name": "zk/main.tf", "content": main_tf},
            "target": f"{dir}/main.tf",
            "data": {"node": node},
        }
    ]
    if opts.get("blue/event") == "delete":
        out = await tofu.tofu_step(opts, dir=dir)
        return out if (out.get("blue/exit") or 0) > 0 else scaffold(out, specs)
    return await tofu.tofu_step(scaffold(opts, specs), dir=dir)


def zoo_cfg_step(opts):
    nodes = opts["zk/servers"]
    if opts.get("blue/event") == "delete":
        servers = nodes
    else:
        servers = sorted(
            (b["tofu/outputs"] for b in opts["blue/branches"]), key=lambda o: o["id"]
        )
    specs = [
        {
            "template": {"name": "zk/zoo.cfg", "content": zoo_cfg},
            "target": f"{workdir(opts)}/nodes/{n['id']}/zoo.cfg",
            "data": {"servers": servers},
        }
        for n in nodes
    ]
    return scaffold(opts, specs)


def cluster_wire_fn(s, _run_opts):
    return {
        "zk/start": (start_step, "zk/node"),
        "zk/node": (node_step, "zk/zoo-cfg"),
        "zk/zoo-cfg": (zoo_cfg_step,),
    }.get(s)


def cluster_next_fn(s, default_next, opts):
    if (opts.get("blue/exit") or 0) > 0:
        return []
    if s == "zk/start":
        return [("zk/node", {**opts, "zk/node": n}) for n in opts["zk/servers"]]
    return [(n, opts) for n in (default_next or [])]


# the child ships its default backend; a parent can replace it by re-adding
# advice under the same id ("zk/backend"), or redefine zk/node wholesale
# with an override advice
cluster_wf = advice_add(
    workflow(start="zk/start", wire_fn=cluster_wire_fn, next_fn=cluster_next_fn),
    "zk/node",
    "before",
    "zk/backend",
    tofu.local_backend_advice(lambda o: node_dir(o, o["zk/node"])),
)

# --- the higher-level workflow: one cluster_wf run per cluster ----------------


def _cluster_in(opts):
    c = opts["zk/cluster"]
    return {
        **opts,
        "zk/servers": c["servers"],
        "zk/workdir": f"{opts['zk/workdir']}/{c['name']}",
    }


def _report_step(opts):
    for b in opts["blue/branches"]:
        runtime.log("cluster ready:", b["zk/workdir"])
    return opts


def clusters_wire_fn(s, _run_opts):
    return {
        "clusters/start": (start_step, "clusters/cluster"),
        "clusters/cluster": (step(cluster_wf, in_=_cluster_in), "clusters/report"),
        "clusters/report": (_report_step,),
    }.get(s)


def clusters_next_fn(s, default_next, opts):
    if (opts.get("blue/exit") or 0) > 0:
        return []
    if s == "clusters/start":
        return [("clusters/cluster", {**opts, "zk/cluster": c}) for c in opts["zk/clusters"]]
    return [(n, opts) for n in (default_next or [])]


def _audit_advice(opts):
    runtime.log(
        "node",
        (opts.get("zk/node") or {}).get("name"),
        "of cluster",
        (opts.get("zk/cluster") or {}).get("name"),
    )
    return opts


wf = workflow(start="clusters/start", wire_fn=clusters_wire_fn, next_fn=clusters_next_fn)
# cross-workflow advice: zk/node and zk/zoo-cfg live inside the embedded
# cluster_wf, but advice is inherited through `step` — flat step names reach
# any depth, parent advice is outermost
wf = advice_add(wf, "zk/node", "before", "clusters/audit", _audit_advice)
# dry-run for the whole composition, declared once at the top; inspect the
# resulting stack with e.g. advice_plan([wf, cluster_wf], "zk/node")
wf = dry_run.advise(wf, ["zk/node", "zk/zoo-cfg"])


def file_arg(a):
    return a in ("-f", "--file") or a.startswith("--file=")


def default_args(args):
    return args if any(file_arg(a) for a in args) else [*args, "-f", f"{SCRIPT_DIR}/blue.yml"]


def run(*args):
    """REPL/test-friendly entrypoint: resolves without calling sys.exit."""
    return run_cli(wf, default_args(list(args)))


if __name__ == "__main__":
    exec_cli(wf, default_args(sys.argv[1:]))
