#!/usr/bin/env -S uv run --script
# -*- mode: python-ts; -*-
# /// script
# requires-python = ">=3.11"
# dependencies = ["blue"]
#
# [tool.uv.sources]
# blue = { path = "../.." }
# ///
"""Offline application: its CLI, file handling and reporting belong here."""
import argparse
import asyncio
import sys
from pathlib import Path

import yaml

from blue.cli import load_yaml, read_pars
from blue.workflow import advice_add_all, failed, run as run_workflow, step, workflow

SCRIPT_DIR = Path(__file__).resolve().parent


async def sh(*cmd: str) -> tuple[int, str, str]:
    try:
        proc = await asyncio.create_subprocess_exec(
            *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
        )
    except OSError as error:
        return 127, "", str(error)
    out, err = await proc.communicate()
    return proc.returncode, out.decode(), err.decode()


def workdir(opts) -> Path:
    return Path(opts["hello/state-file"]).parent / str(opts.get("workdir") or "work")


async def system_step(opts):
    code, out, err = await sh("uname", "-s")
    if code != 0:
        return {**opts, "blue/exit": code, "blue/err": f"uname failed: {err.strip()}"}
    return {**opts, "hello/system": out.strip()}


def greet_step(opts):
    target = workdir(opts) / f"{opts['hello/name']}.txt"
    if opts["hello/event"] == "delete":
        target.unlink(missing_ok=True)
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(f"hello {opts['hello/name']} from {opts['hello/system']}\n")
    return {**opts, "hello/file": str(target)}


def verify_step(opts):
    target = Path(opts["hello/file"])
    if opts["hello/event"] == "delete":
        assert not target.exists(), "greeting was not removed"
    else:
        assert target.read_text() == f"hello {opts['hello/name']} from {opts['hello/system']}\n"
    return dict(opts)


async def report_step(opts):
    files = sorted(b["hello/file"] for b in opts.get("blue/branches", [opts]))
    if opts["hello/event"] == "delete":
        directory = workdir(opts)
        if directory.is_dir() and not any(directory.iterdir()):
            directory.rmdir()
        return {**opts, "hello/report": f"removed {len(files)} files"}
    code, out, err = await sh("cat", *files)
    if code != 0:
        return {**opts, "blue/exit": code, "blue/err": f"cat failed: {err.strip()}"}
    print(out, end="")
    return {**opts, "hello/report": out}


# One reusable operation, embedded once per name by the parent DAG.
greeting = workflow(start="hello/greet", wire_fn=lambda name, _: {
    "hello/greet": (greet_step, "hello/verify"),
    "hello/verify": (verify_step,),
}.get(name))


def wire_fn(name, _run_opts):
    return {
        "hello/system": (system_step, "hello/person"),
        "hello/person": (step(greeting), "hello/report"),
        "hello/report": (report_step,),
    }.get(name)


def next_fn(name, default_next, opts):
    if failed(opts):
        return []
    if name == "hello/system":
        return [("hello/person", {**opts, "hello/name": n}) for n in opts["names"]]
    return [(s, opts) for s in (default_next or [])]


async def report_stage(inner, opts):
    """Application-defined advice, inherited by the greeting subworkflow."""
    print(f">>> {opts['blue/step']} ({opts['hello/event']})", file=sys.stderr)
    result = await inner(opts)
    print(f"<<< {opts['blue/step']} (exit {result.get('blue/exit', 0)})", file=sys.stderr)
    return result


wf = advice_add_all(workflow(start="hello/system", wire_fn=wire_fn, next_fn=next_fn),
                    "around", "hello/report-stage", report_stage)


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise ValueError(message)


async def run(*args):
    """Application entrypoint; the SDK supplies execution, not a CLI."""
    parser = Parser(prog="hello")
    parser.add_argument("event", choices=["create", "delete"])
    parser.add_argument("-f", "--file", default=str(SCRIPT_DIR / "blue.yml"))
    try:
        parsed = parser.parse_args(args)
        path = Path(parsed.file).resolve()
        loaded = load_yaml(path.read_text())
        if not isinstance(loaded, dict):
            raise ValueError("configuration must be a mapping")
        config = read_pars(loaded)
        names = config.get("names")
        if not isinstance(names, list) or not names or any(
            not isinstance(name, str) or not name.isalnum() for name in names
        ) or len(set(names)) != len(names):
            raise ValueError("names must be a nonempty list of unique alphanumeric strings")
        if not isinstance(config.get("workdir", "work"), str):
            raise ValueError("workdir must be a string")
    except (ValueError, OSError, yaml.YAMLError) as error:
        return {"blue/exit": 2, "blue/err": str(error)}
    return await run_workflow(wf, {**config, "hello/state-file": str(path), "hello/event": parsed.event})


if __name__ == "__main__":
    result = asyncio.run(run(*sys.argv[1:]))
    if result.get("blue/err"):
        print(result["blue/err"], file=sys.stderr)
    sys.exit(result.get("blue/exit", 0))
